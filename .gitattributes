# Auto detect text files and perform LF normalization
* text=auto

# Native resources must preserve BOM, CRLF, quoted cells and trailing blank rows.
EN/** -text
PTBR/** -text
LICENSE -text
.gitattributes text eol=lf
.gitignore text eol=lf
*.py text eol=lf
*.cs text eol=lf
*.ps1 text eol=lf
translation-work/managed/*.exe -text
translation-work/vendor/** -text
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.yml text eol=lf
